{
  "name": "asj-portal",
  "private": true,
  "version": "1.0.0",
  "description": "PT Amanah Sakura Japan - Portal Lowongan (static frontend + rebuilt Netlify Functions backend)",
  "scripts": {
    "e2e": "node e2e/login-check.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:css": "tailwindcss -i ./src/main.css -o ./assets/main.css --minify",
    "build:js": "node scripts/build-js.mjs",
    "build:html": "node scripts/build-html.mjs",
    "build": "bun run build:css && bun run build:html && bun run build:js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "qrcode-generator": "^2.0.4",
    "tailwindcss": "4.3.3",
    "vitest": "^4.1.10"
  }
}
