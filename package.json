{
  "name": "asj-portal",
  "private": true,
  "version": "1.0.0",
  "description": "PT Amanah Sakura Japan - Portal Lowongan (static frontend + rebuilt Netlify Functions backend)",
  "scripts": {
    "e2e": "node e2e/login-check.mjs",
    "e2e:share": "node e2e/share-view.mjs",
    "e2e:upload": "node e2e/upload-check.mjs",
    "e2e:biodata": "node e2e/biodata-check.mjs",
    "dedupe": "node scripts/dedupe-duplicates.mjs",
    "dedupe:apply": "node scripts/dedupe-duplicates.mjs --apply",
    "test": "vitest run",
    "lint": "eslint . && bun run check:i18n",
    "bundle:size": "node scripts/bundle-size-report.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "ship": "bash scripts/ship.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hook:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true",
    "build:css": "tailwindcss -i ./src/main.css -o ./assets/main.css --minify",
    "build:js": "node scripts/build-js.mjs",
    "build:html": "node scripts/build-html.mjs",
    "deploy": "bun scripts/deploy-netlify.mjs",
    "check:globals": "node scripts/check-globals.mjs",
    "check:handlers": "node scripts/check-handlers.mjs",
    "build": "bun run check:globals && bun run check:handlers && bun run build:css && bun run build:html && bun run build:js"
  },
  "dependencies": {
    "@sentry/browser": "^10.70.0",
    "bcryptjs": "^3.0.3",
    "web-vitals": "^6.1.1"
  },
  "devDependencies": {
    "@sentry/cli": "^3.6.2",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "netlify-cli": "^27.1.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "qrcode-generator": "^2.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
